{
  "version": 1,
  "operation": "interruptSession",
  "mutation": true,
  "features": [
    "stop"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workspaceID": {
        "type": "string",
        "minLength": 1
      },
      "sessionID": {
        "type": "string",
        "minLength": 1
      },
      "requestID": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "workspaceID",
      "sessionID",
      "requestID"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "accepted"
          },
          "requestID": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "state",
          "requestID"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "complete"
          },
          "requestID": {
            "type": "string",
            "minLength": 1
          },
          "messageID": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "state",
          "requestID"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "unknown"
          },
          "requestID": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "requestID",
          "reason"
        ],
        "additionalProperties": false
      }
    ]
  },
  "examples": {
    "input": {
      "workspaceID": "fixture-workspace",
      "sessionID": "fixture-session",
      "requestID": "fixture-request"
    },
    "output": {
      "state": "complete",
      "requestID": "fixture-request"
    },
    "invalidOutput": {
      "state": "complete"
    }
  },
  "semantics": {
    "en": [
      "requestID identifies the interruption attempt.",
      "A complete receipt reports the control request completed, not that an already-finished task was undone."
    ],
    "zh": [
      "requestID 标识这次中断尝试。",
      "complete 回执表示控制请求完成，不表示已经结束的任务被撤销。"
    ]
  }
}
