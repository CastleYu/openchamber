{
  "version": 1,
  "operation": "removeSession",
  "mutation": true,
  "features": [
    "remove"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workspaceID": {
        "type": "string",
        "minLength": 1
      },
      "sessionID": {
        "type": "string",
        "minLength": 1
      },
      "requestID": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "workspaceID",
      "sessionID",
      "requestID"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "accepted"
          },
          "requestID": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "state",
          "requestID"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "complete"
          },
          "requestID": {
            "type": "string",
            "minLength": 1
          },
          "messageID": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "state",
          "requestID"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "unknown"
          },
          "requestID": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "requestID",
          "reason"
        ],
        "additionalProperties": false
      }
    ]
  },
  "examples": {
    "input": {
      "workspaceID": "fixture-workspace",
      "sessionID": "fixture-session",
      "requestID": "fixture-request"
    },
    "output": {
      "state": "complete",
      "requestID": "fixture-request"
    },
    "invalidOutput": {
      "state": "deleted",
      "requestID": "fixture-request"
    }
  },
  "semantics": {
    "en": [
      "requestID identifies this mutation.",
      "An unknown receipt preserves uncertainty and must not be described as deletion success."
    ],
    "zh": [
      "requestID 标识这次变更。",
      "unknown 回执表示结果不确定，不能描述为删除成功。"
    ]
  }
}
