+  BEGIN: z.object({ ...BASE, [FIELD.PROVIDER]: z.string().min(1), [FIELD.METHOD]: z.number().int().nonnegative() }).strict(),
+  ATTEMPT: z.object({ [FIELD.ATTEMPT]: z.string().min(1) }).strict(),
+  CALLBACK: z.object({ [FIELD.ATTEMPT]: z.string().min(1), [FIELD.CODE]: z.string().optional() }).strict(),
+});
+const OUTCOME = z.object({
+  persisted: z.boolean().optional(), partial: z.boolean().optional(), requiresRestart: z.boolean().optional(), removed: z.array(z.string()).optional(),
+  remaining: z.array(z.string()).optional(), credential: z.enum(['retained', 'removed', 'unknown', 'absent']).optional(),
+}).strict();
+const CALLER = z.discriminatedUnion('type', [
+  z.object({ type: z.literal('session'), token: z.string().min(1) }),
+  z.object({ type: z.literal('client'), clientId: z.string().min(1) }),
+]);
+const CALLER_PREFIX = 'legacy-provider-';
+const CALLER_VALUE = z.string().min(1);
+const STATUS_CODE = z.number().int().min(400).max(599);
+const CREDENTIAL = z.enum(['retained', 'removed', 'unknown', 'absent']);
+
+function createLegacyProviderCaller({ getUiAuth }) {
+  return async (req, res) => {
+    try {
+      const auth = getUiAuth();
+      if (!auth) return null;
+      let admitted = false;
+      await auth.requireAuth(req, res, () => { admitted = true; });
+      if (!admitted) return null;
+      let context = await auth.resolveVerifiedAuthContext(req);
+      if (!context && auth.enabled === false) {
+        context = await auth.resolveAuthContext(req, res, { allowClientAuth: true, allowUrlToken: false });
+      }
+      const parsed = CALLER.safeParse(context);
+      if (!parsed.success) return null;
+      const { type } = parsed.data;
+      const key = type === 'session' ? parsed.data.token : parsed.data.clientId;
+      return `${CALLER_PREFIX}${createHash('sha256').update(JSON.stringify([type, key])).digest('hex')}`;
+    } catch {
+      return null;
+    }
+  };
+}
+
+function sameIdentity(left, right) {
+  const parsed = IDENTITY.safeParse(right);
+  return parsed.success && left.generation === parsed.data.generation && left.profile === parsed.data.profile
+    && left.version === parsed.data.version && left.endpoint === parsed.data.endpoint && left.epoch === parsed.data.epoch;
+}
+
+function requestSignal(req, res) {
+  const controller = new AbortController();
+  const aborted = () => controller.abort();
+  const closed = () => { if (!res.writableEnded) controller.abort(); };
+  req.once('aborted', aborted);
+  res.once('close', closed);
+  return { signal: controller.signal, detach: () => { req.removeListener('aborted', aborted); res.removeListener('close', closed); } };
+}
+
+function outcomeOf(error) {
+  const parsed = OUTCOME.safeParse(error?.outcome);
+  return parsed.success ? parsed.data : null;
+}
+
+function sendError(res, error) {
+  const parsedStatus = STATUS_CODE.safeParse(error?.statusCode);
+  const status = parsedStatus.success ? parsedStatus.data : STATUS.SERVER;
+  const partial = outcomeOf(error);
+  const parsedCredential = CREDENTIAL.safeParse(error?.credential);
+  const parsedRestart = z.boolean().safeParse(error?.requiresRestart);
+  const credential = parsedCredential.success ? parsedCredential.data : undefined;
+  const requiresRestart = parsedRestart.success ? parsedRestart.data : undefined;
+  const body = { error: MESSAGE.SERVER };
+  if (partial) body.outcome = partial;
+  if (credential !== undefined) body.credential = credential;
+  if (requiresRestart !== undefined) body.requiresRestart = requiresRestart;
+  res.status(status).json(body);
+}
+
+function createLegacyProviderHttp({ api, getRuntime, resolveCaller }) {
+  const register = app => {
+    const route = (path, schema, run, needsIdentity = false) => app.post(`${ROUTE.BASE}${path}`, async (req, res) => {
+      res.set('Cache-Control', 'no-store');
+      let caller;
+      try { caller = await resolveCaller(req, res); }
+      catch {
+        if (res.headersSent) return undefined;
+        return sendError(res, Object.assign(new Error(MESSAGE.UNAUTHENTICATED), { statusCode: STATUS.UNAUTHENTICATED }));
+      }
+      if (res.headersSent) return undefined;
+      if (!CALLER_VALUE.safeParse(caller).success) return sendError(res, Object.assign(new Error(MESSAGE.UNAUTHENTICATED), { statusCode: STATUS.UNAUTHENTICATED }));
+      const parsed = schema.safeParse(req.body);
+      if (!parsed.success) return sendError(res, Object.assign(new Error(MESSAGE.BAD), { statusCode: STATUS.BAD }));
+      const input = parsed.data;
+      if (needsIdentity) {
+        let runtime;
+        try { runtime = getRuntime(); }
+        catch { return sendError(res, Object.assign(new Error(MESSAGE.SERVER), { statusCode: STATUS.SERVER })); }
+        if (!sameIdentity(input[FIELD.IDENTITY], runtime)) return sendError(res, Object.assign(new Error(MESSAGE.STALE), { statusCode: STATUS.STALE }));
+      }
+      const transport = requestSignal(req, res);
+      try {
+        const value = await run({ caller, input, signal: transport.signal });
+        if (path === ROUTE.SAVE || path === ROUTE.CALLBACK) return res.json({ persisted: true, requiresRestart: true });
+        if (path === ROUTE.CANCEL) return res.json({ canceled: true });
+        return res.json(value ?? {});
+      } catch (error) { return sendError(res, error); }
+      finally { transport.detach(); }
+    });
+
+    route(ROUTE.METHODS, SCHEMA.METHODS, ({ input, signal }) => api.methods({ directory: input.directory, signal }), true);
+    route(ROUTE.SOURCES, SCHEMA.SOURCES, ({ input }) => api.sources(input.providerID, input.directory), true);
+    route(ROUTE.SAVE, SCHEMA.SAVE, ({ input, signal }) => api.save({ key: input.key, providerID: input.providerID, directory: input.directory, signal, expectedIdentity: input.identity }), true);
+    route(ROUTE.DISCONNECT, SCHEMA.DISCONNECT, ({ input, signal }) => api.disconnect(input.providerID, input.directory, signal), true);
+    route(ROUTE.BEGIN, SCHEMA.BEGIN, ({ caller, input, signal }) => api.beginOAuth(caller, { providerID: input.providerID, method: input.method, directory: input.directory, signal }), true);
+    route(ROUTE.AUTHORIZE, SCHEMA.ATTEMPT, ({ caller, input }) => api.authorizeOAuth(caller, input.attemptId));
+    route(ROUTE.CALLBACK, SCHEMA.CALLBACK, ({ caller, input }) => api.callbackOAuth(caller, input.attemptId, input.code === undefined ? {} : { code: input.code }));
+    route(ROUTE.CANCEL, SCHEMA.ATTEMPT, ({ caller, input }) => api.cancelOAuth(caller, input.attemptId));
+    return app;
+  };
+
+  return { register };
+}
+
+export { createLegacyProviderCaller, createLegacyProviderHttp };
