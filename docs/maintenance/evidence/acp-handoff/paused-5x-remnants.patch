+  BEGIN: '/oauth/begin', AUTHORIZE: '/oauth/authorize', CALLBACK: '/oauth/callback', CANCEL: '/oauth/cancel',
+});
+const FIELD = Object.freeze({ IDENTITY: 'identity', DIRECTORY: 'directory', PROVIDER: 'providerID', KEY: 'key', METHOD: 'method', ATTEMPT: 'attemptId', CODE: 'code' });
+const STATUS = Object.freeze({ BAD: 400, UNAUTHENTICATED: 401, STALE: 409, SERVER: 500 });
+const MESSAGE = Object.freeze({ BAD: 'Invalid provider request', UNAUTHENTICATED: 'Authentication required', STALE: 'OpenCode runtime identity changed', SERVER: 'Provider request failed' });
