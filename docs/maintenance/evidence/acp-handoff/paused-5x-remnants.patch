+  METHODS: z.object(BASE).strict(),
+  SOURCES: z.object({ ...BASE, [FIELD.PROVIDER]: z.string().min(1) }).strict(),
+  SAVE: z.object({ ...BASE, [FIELD.PROVIDER]: z.string().min(1), [FIELD.KEY]: z.string().min(1) }).strict(),
